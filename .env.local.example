# Copiá este archivo a .env.local y completá los valores desde
# Supabase Dashboard -> Project Settings -> API.
# .env.local ya está en .gitignore — nunca se commitea.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role secret — NUNCA con prefijo NEXT_PUBLIC_, NUNCA en el bundle del
# cliente. Solo se usa server-side (lib/supabase/admin.ts) para invitar
# usuarios cliente vía la Admin API de Supabase Auth.
SUPABASE_SERVICE_ROLE_KEY=
